# Configuración del Servidor
PORT=3001
NODE_ENV=development

# Proveedor de IA Principal ('gemini', 'anthropic', 'openai', 'nvidia', 'deepseek', 'groq', 'openrouter', 'cohere', 'local', 'custom')
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# API Keys de Inteligencia Artificial (Dejar vacías si se configuran desde la UI web)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# Configuración de Voz (TTS)
TTS_PROVIDER=edge
AI_VOICE_MODEL=es-MX-DaliaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_APP_ID=
MERCADOPAGO_USER_ID=

# WooCommerce Sync
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
