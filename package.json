{
  "name": "wagent-crm",
  "version": "1.3.3",
  "description": "WhatsApp CRM with AI Sales, Support, Voice Notes and Call Management",
  "main": "server/index.js",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/index.js",
    "start:cluster": "node server/cluster.js",
    "dev:server": "node --watch server/index.js",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run client\"",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs wagent-crm",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@caveman-ai/sdk": "^1.0.0",
    "@google/generative-ai": "^0.24.0",
    "@hapi/boom": "^10.0.1",
    "@sentropic/graphify": "^0.17.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "mongodb": "^6.21.0",
    "msedge-tts": "^2.0.7",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
