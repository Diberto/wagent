{
  "name": "wagent-crm",
  "version": "1.3.3",
  "description": "WhatsApp CRM with AI Sales, Support, Voice Notes and Call Management",
  "main": "server/index.js",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/index.js",
    "mcp": "node server/mcp-server.js",
    "mcp:hostinger": "node server/mcp-hostinger-client.js",
    "start:cluster": "node server/cluster.js",
    "dev:server": "node --watch server/index.js",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run client\"",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs wagent-crm",
    "deploy": "bash scripts/deploy.sh",
    "deploy:notify": "node scripts/trigger-deploy.js",
    "setup:nginx": "sudo bash scripts/setup-nginx.sh",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@caveman-ai/sdk": "^1.0.0",
    "@google/generative-ai": "^0.24.0",
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sentropic/graphify": "^0.17.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "mongodb": "^6.21.0",
    "msedge-tts": "^2.0.7",
    "multer": "^2.3.0",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@ai-sdk/provider-utils": ">=3.0.28",
    "@babel/core": ">=7.29.6",
    "@grpc/grpc-js": ">=1.14.5",
    "@opentelemetry/core": ">=2.8.0",
    "@simple-git/argv-parser": ">=2.0.1",
    "body-parser": ">=1.20.9",
    "brace-expansion": ">=2.1.7",
    "csv-parse": ">=7.0.2",
    "engine.io": ">=6.6.10",
    "esbuild": ">=0.28.1",
    "fast-copy": ">=4.1.0",
    "fast-uri": ">=3.1.9",
    "follow-redirects": ">=1.16.1",
    "hono": ">=4.13.11",
    "ip-address": ">=10.7.4",
    "music-metadata": ">=11.16.0",
    "pdfjs-dist": ">=6.2.108",
    "postcss-selector-parser": "6.1.5",
    "proxy-addr": ">=2.0.8",
    "qs": ">=6.16.1",
    "shell-quote": ">=1.11.0",
    "simple-git": ">=4.0.1",
    "source-map-js": ">=1.2.2",
    "undici": ">=6.29.1",
    "vite": "~6.4.5",
    "zod": ">=4.6.6",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "nodeLlamaCpp": {
    "nodeLlamaCppPostinstall": "skip"
  }
}
